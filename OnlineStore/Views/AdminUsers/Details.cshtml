@model OnlineStore.Models.User
@{ ViewData["Title"] = "User Details"; }
<div class="confirmation"><h1>User Details</h1><p><strong>Id:</strong> @Model.Id</p><p><strong>Name:</strong> @Model.Name</p><p><strong>Email:</strong> @Model.Email</p><p><strong>Role:</strong> <span class="badge @(Model.Role == "Admin" ? "text-bg-success" : "text-bg-secondary")">@Model.Role</span></p><a class="btn btn-outline-primary mt-2" asp-action="Index">Back to Users</a></div>
