@model IEnumerable<OnlineStore.Models.User>
@{ ViewData["Title"] = "Manage Users"; }
<div class="d-flex flex-wrap justify-content-between align-items-center mb-3"><div><h1 class="mb-1">Manage Users</h1><p class="text-muted mb-0">Registered accounts in Online Store.</p></div><span class="badge text-bg-primary fs-6">@Model.Count() Users</span></div>
<div class="table-responsive"><table class="table"><thead><tr><th>Id</th><th>Name</th><th>Email</th><th>Role</th><th></th></tr></thead><tbody>@foreach (var user in Model) { <tr><td>@user.Id</td><td>@user.Name</td><td>@user.Email</td><td><span class="badge @(user.Role == "Admin" ? "text-bg-success" : "text-bg-secondary")">@user.Role</span></td><td><a asp-action="Details" asp-route-id="@user.Id">Details</a></td></tr> }</tbody></table></div>
