@model OnlineStore.Models.Product
@{ViewData["Title"]="Product Details";}<div class="row"><div class="col-md-6"><img class="img-fluid product-image" src="@Model.ImageUrl" alt="@Model.Name" /></div><div class="col-md-6"><h1>@Model.Name</h1><p>@Model.Description</p><p><strong>Category:</strong> @Model.Category?.Name</p><p><strong>Stock:</strong> @Model.StockQuantity</p><h3 class="price">$@Model.Price.ToString("0.00")</h3><form asp-controller="Cart" asp-action="AddToCart" method="post"><input type="hidden" name="productId" value="@Model.Id"/><button class="btn btn-primary" disabled="@(Model.StockQuantity == 0)">Add to Cart</button></form></div></div>
