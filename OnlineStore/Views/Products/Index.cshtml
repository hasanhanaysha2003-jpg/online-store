@model OnlineStore.ViewModels.ProductsViewModel
@{ ViewData["Title"]="Products"; }
<h1>Products</h1><form method="get" class="row g-2 mb-4"><div class="col-md-5"><input class="form-control" name="search" value="@Model.Search" placeholder="Search by product name" /></div><div class="col-md-4"><select class="form-select" name="categoryId"><option value="">All Categories</option>@foreach(var c in Model.Categories){<option value="@c.Id" selected="@(Model.CategoryId == c.Id)">@c.Name</option>}</select></div><div class="col-md-2"><button class="btn btn-primary">Search</button></div></form>@if (!string.IsNullOrWhiteSpace(Model.Search)) { <h2 class="search-result-title">Search Results for "@Model.Search"</h2> }<div class="row">@foreach(var product in Model.Products){<partial name="_ProductCard" model="product"/>}</div>@if(!Model.Products.Any()){<p>No products found. Try another name or category.</p>}@if(Model.SimilarProducts.Any()){<section class="similar-products"><h2>Similar Products</h2><p class="text-muted">Products from the same category.</p><div class="row">@foreach(var product in Model.SimilarProducts){<partial name="_ProductCard" model="product"/>}</div></section>}
