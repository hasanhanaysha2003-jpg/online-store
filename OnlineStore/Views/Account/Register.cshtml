@model OnlineStore.Models.User
@{ ViewData["Title"] = "Register"; }
<section class="auth-page">
    <div class="auth-card">
        <div class="auth-icon">S</div>
        <h1>Create Account</h1>
        <p class="auth-subtitle">Join Online Store and start shopping today.</p>
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
            <div class="auth-field"><label asp-for="Name">Full Name</label><input asp-for="Name" class="form-control" placeholder="Enter your full name" autocomplete="name" /><span asp-validation-for="Name" class="text-danger"></span></div>
            <div class="auth-field"><label asp-for="Email">Email Address</label><input asp-for="Email" class="form-control" placeholder="name@example.com" autocomplete="email" /><span asp-validation-for="Email" class="text-danger"></span></div>
            <div class="auth-field"><label asp-for="Password">Password</label><input asp-for="Password" class="form-control" placeholder="At least 4 characters" autocomplete="new-password" /><span asp-validation-for="Password" class="text-danger"></span></div>
            <button class="btn btn-primary auth-submit">Create Account</button>
        </form>
        <p class="auth-switch">Already have an account? <a asp-action="Login">Login here</a></p>
    </div>
</section>