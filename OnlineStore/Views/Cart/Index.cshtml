@model OnlineStore.ViewModels.CartViewModel
@{ViewData["Title"]="Shopping Cart";}<h1>Shopping Cart</h1>@if(!Model.Items.Any()){<p>Your cart is empty. <a asp-controller="Products" asp-action="Index">Continue shopping</a></p>}else{<table class="table"><thead><tr><th>Product</th><th>Price</th><th>Quantity</th><th>Subtotal</th><th></th></tr></thead><tbody>@foreach(var item in Model.Items){<tr><td>@item.Name</td><td>$@item.Price.ToString("0.00")</td><td><form class="d-inline" asp-action="Decrease" method="post"><input type="hidden" name="productId" value="@item.ProductId"/><button class="btn btn-sm btn-secondary">-</button></form> @item.Quantity <form class="d-inline" asp-action="Increase" method="post"><input type="hidden" name="productId" value="@item.ProductId"/><button class="btn btn-sm btn-secondary">+</button></form></td><td>$@item.Subtotal.ToString("0.00")</td><td><form asp-action="Remove" method="post"><input type="hidden" name="productId" value="@item.ProductId"/><button class="btn btn-sm btn-danger">Remove</button></form></td></tr>}</tbody></table><h4>Total: $@Model.Total.ToString("0.00")</h4><form class="d-inline" asp-action="Clear" method="post"><button class="btn btn-outline-danger">Clear Cart</button></form> <a class="btn btn-primary" asp-controller="Orders" asp-action="Checkout">Checkout</a>}
