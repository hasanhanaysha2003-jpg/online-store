@model IEnumerable<OnlineStore.Models.Product>
@{ViewData["Title"]="Manage Products";}<h1>Manage Products</h1><a class="btn btn-primary mb-3" asp-action="Create">Create Product</a><table class="table"><thead><tr><th>Name</th><th>Price</th><th>Category</th><th>Stock</th><th></th></tr></thead><tbody>@foreach(var p in Model){<tr><td>@p.Name</td><td>$@p.Price</td><td>@p.Category?.Name</td><td>@p.StockQuantity</td><td><a asp-action="Details" asp-route-id="@p.Id">Details</a> | <a asp-action="Edit" asp-route-id="@p.Id">Edit</a> | <a asp-action="Delete" asp-route-id="@p.Id">Delete</a></td></tr>}</tbody></table>
