@model OnlineStore.Models.Product
<div class="col-md-4 mb-3"><div class="card product-card"><img src="@Model.ImageUrl" class="card-img-top" alt="@Model.Name"><div class="card-body"><h5>@Model.Name</h5><p class="text-muted">@Model.Category?.Name</p><p class="price">$@Model.Price.ToString("0.00")</p><a class="btn btn-outline-primary btn-sm" asp-controller="Products" asp-action="Details" asp-route-id="@Model.Id">Details</a> <form class="d-inline" asp-controller="Cart" asp-action="AddToCart" method="post"><input type="hidden" name="productId" value="@Model.Id"/><button class="btn btn-primary btn-sm">Add to Cart</button></form></div></div></div>
