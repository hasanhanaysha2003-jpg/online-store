@model OnlineStore.Models.Order
@{ViewData["Title"]="Checkout";}<h1>Checkout</h1><p><strong>Order Total: $@(((decimal)ViewBag.Total).ToString("0.00"))</strong></p><form method="post" class="form-box"><div asp-validation-summary="ModelOnly" class="text-danger"></div><label asp-for="CustomerName"></label><input asp-for="CustomerName" class="form-control"/><span asp-validation-for="CustomerName" class="text-danger"></span><label asp-for="CustomerEmail"></label><input asp-for="CustomerEmail" class="form-control"/><span asp-validation-for="CustomerEmail" class="text-danger"></span><label asp-for="CustomerPhone"></label><input asp-for="CustomerPhone" class="form-control"/><span asp-validation-for="CustomerPhone" class="text-danger"></span><label asp-for="Address"></label><textarea asp-for="Address" class="form-control"></textarea><span asp-validation-for="Address" class="text-danger"></span><button class="btn btn-primary mt-3">Place Order</button></form>
