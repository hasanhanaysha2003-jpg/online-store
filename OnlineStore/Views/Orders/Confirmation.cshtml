@model OnlineStore.Models.Order
@{ViewData["Title"]="Order Confirmation";}<div class="confirmation"><h1>Order Confirmed</h1><p>Thank you for your order.</p><p><strong>Order Id:</strong> @Model.Id</p><p><strong>Customer:</strong> @Model.CustomerName</p><p><strong>Total Price:</strong> $@Model.TotalPrice.ToString("0.00")</p><p><strong>Order Date:</strong> @Model.OrderDate.ToString("g")</p><a class="btn btn-primary" asp-controller="Products" asp-action="Index">Continue Shopping</a></div>
